# PyInstaller 打包产物（build 376MB + dist 355MB，绝不入库）
build/
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 运行数据：日志 / PID / 调试输出
log/
run.log
run.pid
gui_debug.txt

# 临时截图与中间产物
*.tmp

# 随包携带的微软扫雷本体（本地运行/打包需要，但不入库：
# 微软版权二进制 + 5.3MB 体积；打包时 .spec 会从磁盘读，不受本规则影响）
Minesweeper.exe
Minesweeper.dll
slc.dll
zh-CN/
